# Optional local runtime overrides. Model connections are configured in the UI.
# Copy to .env only if you actually need to change the defaults; never commit real secrets.
FYADR_CONFIG_DIR=
FYADR_DATA_DIR=
FYADR_PORT=8765
FYADR_MAX_UPLOAD_BYTES=41943040
# Upper bound for pasted plain text (characters). Defaults to 300000.
FYADR_MAX_TEXT_CHARS=300000
